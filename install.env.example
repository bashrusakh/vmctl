# install.env.example
# Copy to install.env and edit:
#   cp install.env.example install.env
#   nano install.env
#
# Then run:
#   sudo scripts/install-full-stack.sh --env ./install.env

# =========================
# ESXi root/bootstrap access
# =========================

ESXI_HOST="192.168.1.10"
ESXI_ROOT_USER="root"
ESXI_ROOT_PORT="22"

# Optional. If empty, ssh/scp will use default auth/agent/interactive password.
# Example: ESXI_ROOT_SSH_KEY="/root/.ssh/id_ed25519"
ESXI_ROOT_SSH_KEY=""
# Optional override via environment variable only (do NOT store in file):
#   export ESXI_ROOT_PASS='...'
# If ESXI_ROOT_SSH_KEY is empty and ESXI_ROOT_PASS is unset,
# installer will ask interactively (hidden input).

# =========================
# Datastores / networks
# =========================

# Comma-separated datastore allowlist.
DATASTORES="datastore1,ssd1"

# Default datastore if vmctl create does not receive --datastore.
DEFAULT_DATASTORE="datastore1"

# Main/default Port Group for new VMs.
DEFAULT_NETWORK="VM Network"

# Comma-separated list. Include DEFAULT_NETWORK here.
ALLOWED_NETWORKS="VM Network,LAN-Servers"

# =========================
# Templates
# =========================
#
# Multi-template JSON. Keep paths absolute and under one of DATASTORES.
# For vmctl create:
#   --template alma9
#   --datastore datastore1|ssd1
#
# Recommended first implementation rule:
#   template.datastore is the source datastore;
#   --datastore is the target datastore;
#   cross-datastore clone may be allowed if vmctl supports it.
#
VMCTL_TEMPLATES_JSON='{
  "alma9": {
    "datastore": "datastore1",
    "path": "/vmfs/volumes/datastore1/_templates/alma9-cloud",
    "vmx": "alma9-cloud.vmx",
    "disk": "alma9-cloud.vmdk",
    "allowed_datastores": ["datastore1", "ssd1"]
  },
  "ubuntu2404": {
    "datastore": "ssd1",
    "path": "/vmfs/volumes/ssd1/_templates/ubuntu2404-cloud",
    "vmx": "ubuntu2404-cloud.vmx",
    "disk": "ubuntu2404-cloud.vmdk",
    "allowed_datastores": ["ssd1"]
  }
}'

# =========================
# Hermes-side users
# =========================

# Existing user that runs Hermes agent.
HERMES_USER="hermes"

# Local system user created by installer.
VMCTL_USER="vmctl-runner"
VMCTL_GROUP="vmctl"

# =========================
# ESXi-side users
# =========================

API_USER="vmctl-api"
SSH_USER="vmctl-ssh"

# Leave empty to auto-generate strong random passwords.
# Generated passwords are stored in:
#   /opt/hermes-vmctl/secrets/generated-passwords.txt
API_PASS=""
SSH_PASS=""

# SSH_ROLE:
#   Admin    - practical mode for vmkfstools/vim-cmd on standalone ESXi
#   ReadOnly - likely insufficient, but can be tested
SSH_ROLE="Admin"

# Install restricted forced-command helper on ESXi.
INSTALL_HELPER="1"

# =========================
# vmctl paths
# =========================

APP_DIR="/opt/hermes-vmctl"

# =========================
# Network source restriction
# =========================

# Optional. If empty, installer auto-detects source IP used to reach ESXi.
# This IP is used in authorized_keys from="<HERMES_IP>" restriction.
HERMES_IP=""

# =========================
# vmctl limits
# =========================

MAX_CPU="8"
MAX_RAM_MB="32768"
MAX_DISK_GB="300"
MAX_VMS_TOTAL="20"
MAX_VMS_PER_REQUEST="1"

# =========================
# VM disk format for clones
# =========================
# Allowed: thin | zeroedthick | eagerzeroedthick
VM_DISK_FORMAT="thin"

# =========================
# Protected VM names
# =========================

PROTECTED_VMS="hermes,router,dns,backup,vcenter,openclaw,moltis"

# =========================
# Installer behavior
# =========================

GOVC_INSECURE="1"
DRY_RUN="0"
