#!/usr/bin/env python3
import argparse
import base64
import datetime as dt
import fcntl
import gzip
import ipaddress
import json
import os
import pathlib
import re
import shlex
import subprocess
import shutil
from subprocess import CompletedProcess
from legacy_direct_esxi import run_ssh
import sys
import tempfile
import uuid
from contextlib import contextmanager

import yaml

BASE = pathlib.Path('/opt/hermes-vmctl')
CFG_PATH = BASE / 'config' / 'vmctl.yaml'
INSTALL_ENV_PATH = BASE / 'install.env'
SECRETS_PATH = BASE / 'secrets' / 'esxi.env'
STATE = BASE / 'state'
LOCKS = BASE / 'locks'
AUDIT = BASE / 'logs' / 'audit.log'
VERSION = '0.1.0'

VM_RE = re.compile(r'^[a-zA-Z0-9][a-zA-Z0-9._-]{0,62}$')
HOST_RE = re.compile(r'^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$')


def nowz():
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace('+00:00', 'Z')


def load_config():
    with open(CFG_PATH, 'r', encoding='utf-8') as f:
        cfg = yaml.safe_load(f)
    if not isinstance(cfg, dict):
        raise RuntimeError('config invalid')
    return cfg


def load_env(path=SECRETS_PATH):
    env = {}
    with open(path, 'r', encoding='utf-8') as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            if line.startswith('export '):
                line = line[len('export '):]
            k, v = line.split('=', 1)
            v = v.strip().strip('"').strip("'")
            env[k.strip()] = v
    return env


def _csv_value(s: str):
    return [x.strip() for x in (s or '').split(',') if x.strip()]


def load_install_env(path=INSTALL_ENV_PATH):
    p = pathlib.Path(path)
    if not p.exists():
        raise RuntimeError(f'install env not found: {path}')
    env = {}
    lines = p.read_text(encoding='utf-8').splitlines()
    i = 0
    while i < len(lines):
        raw = lines[i]
        line = raw.strip()
        i += 1
        if not line or line.startswith('#') or '=' not in line:
            continue
        k, v = line.split('=', 1)
        k = k.strip()
        v = v.strip()

        if v.startswith("'") or v.startswith('"'):
            q = v[0]
            body = v[1:]
            while True:
                if body.endswith(q):
                    body = body[:-1]
                    break
                if i >= len(lines):
                    raise RuntimeError(f'unterminated quoted value in install.env for key={k}')
                body += '\n' + lines[i]
                i += 1
            env[k] = body
        else:
            env[k] = v
    return env


def render_cfg_from_install_env(ienv: dict):
    if 'VMCTL_TEMPLATES_JSON' not in ienv:
        raise RuntimeError('install.env missing VMCTL_TEMPLATES_JSON')
    templates = json.loads(ienv['VMCTL_TEMPLATES_JSON'])
    datastores = {
        ds: {
            'path': f'/vmfs/volumes/{ds}',
            'deleted_dir': '_deleted',
            'templates_dir': '_templates',
        }
        for ds in _csv_value(ienv.get('DATASTORES', ''))
    }
    return {
        'esxi': {
            'host': ienv.get('ESXI_HOST'),
            'user': ienv.get('SSH_USER'),
            'ssh_port': 22,
            'ssh_key': f"{ienv.get('APP_DIR', '/opt/hermes-vmctl')}/secrets/vmctl_ssh_key",
            'default_datastore': ienv.get('DEFAULT_DATASTORE'),
            'default_network': ienv.get('DEFAULT_NETWORK'),
            'vm_disk_format': ienv.get('VM_DISK_FORMAT', 'thin'),
        },
        'security': {'allow_direct_esxi': False},
        'datastores': datastores,
        'templates': templates,
        'allowed_networks': _csv_value(ienv.get('ALLOWED_NETWORKS', '')),
        'limits': {
            'max_cpu': int(ienv.get('MAX_CPU', '8')),
            'max_ram_mb': int(ienv.get('MAX_RAM_MB', '32768')),
            'max_disk_gb': int(ienv.get('MAX_DISK_GB', '300')),
            'max_vms_total': int(ienv.get('MAX_VMS_TOTAL', '20')),
            'max_vms_per_request': int(ienv.get('MAX_VMS_PER_REQUEST', '1')),
        },
        'protected_vms': _csv_value(ienv.get('PROTECTED_VMS', '')),
        'delete': {'deleted_dir': '_deleted'},
    }


def _drift_summary(cfg: dict, expected: dict):
    mismatches = []

    if cfg.get('esxi', {}).get('default_datastore') != expected.get('esxi', {}).get('default_datastore'):
        mismatches.append(
            f"esxi.default_datastore cfg={cfg.get('esxi', {}).get('default_datastore')!r} env={expected.get('esxi', {}).get('default_datastore')!r}"
        )

    if set(cfg.get('datastores', {}).keys()) != set(expected.get('datastores', {}).keys()):
        mismatches.append(
            f"datastores keys cfg={sorted(cfg.get('datastores', {}).keys())} env={sorted(expected.get('datastores', {}).keys())}"
        )

    cfg_templates = cfg.get('templates', {})
    exp_templates = expected.get('templates', {})
    if set(cfg_templates.keys()) != set(exp_templates.keys()):
        mismatches.append(f"templates keys cfg={sorted(cfg_templates.keys())} env={sorted(exp_templates.keys())}")

    for tname in sorted(set(cfg_templates.keys()) & set(exp_templates.keys())):
        c = cfg_templates.get(tname, {})
        e = exp_templates.get(tname, {})
        for field in ('datastore', 'path', 'vmx', 'disk'):
            if c.get(field) != e.get(field):
                mismatches.append(f"template.{tname}.{field} cfg={c.get(field)!r} env={e.get(field)!r}")
        c_allowed = sorted(c.get('allowed_datastores') or [])
        e_allowed = sorted(e.get('allowed_datastores') or [])
        if c_allowed != e_allowed:
            mismatches.append(f"template.{tname}.allowed_datastores cfg={c_allowed} env={e_allowed}")

    ok = len(mismatches) == 0
    details = 'in sync' if ok else '; '.join(mismatches[:8])
    if len(mismatches) > 8:
        details += f"; ... +{len(mismatches)-8} more"
    return ok, details


def assert_no_install_env_drift(cfg):
    ienv = load_install_env()
    expected = render_cfg_from_install_env(ienv)
    ok, details = _drift_summary(cfg, expected)
    if not ok:
        raise RuntimeError(
            'install.env drift detected: '
            + details
            + '. Run: sudo scripts/install-full-stack.sh --env /opt/hermes-vmctl/install.env'
        )


def audit_log(operation, vm_name, state_uuid, stage, result, error=None, next_action=None):
    rec = {
        'ts': nowz(), 'actor': 'hermes', 'operation': operation, 'vm_name': vm_name,
        'state_uuid': state_uuid, 'stage': stage, 'result': result,
    }
    if error:
        rec['error'] = error
    if next_action:
        rec['next_action'] = next_action
    AUDIT.parent.mkdir(parents=True, exist_ok=True)
    with open(AUDIT, 'a', encoding='utf-8') as f:
        f.write(json.dumps(rec, ensure_ascii=False) + '\n')


def run_local(args, check=True):
    return subprocess.run(args, check=check, capture_output=True, text=True)


def _ssh_target(env):
    user = env.get('ESXI_USER') or env.get('GOVC_USERNAME', '').split('@')[0] or 'root'
    host = env.get('ESXI_HOST')
    if not host:
        raise RuntimeError('ESXI_HOST is required')
    port = str(env.get('ESXI_SSH_PORT', '22'))
    key = os.path.expanduser(env.get('ESXI_SSH_KEY', '~/.ssh/id_ed25519'))
    return user, host, port, key


def run_esxi_helper(env, args: list[str], stdin: bytes | None = None, check: bool = True) -> CompletedProcess:
    user, host, port, key = _ssh_target(env)
    cmd = ['ssh', '-i', key, '-p', port, f'{user}@{host}', *args]
    return subprocess.run(cmd, input=stdin, check=check, capture_output=True)




def helper_preflight_ok(env):
    cp = run_esxi_helper(env, ['preflight'], check=False)
    out = cp.stdout.decode('utf-8', errors='replace').strip()
    if cp.returncode != 0 or out != 'OK':
        err = cp.stderr.decode('utf-8', errors='replace').strip()
        raise RuntimeError(f"ESXi helper preflight failed: rc={cp.returncode}, out={out!r}, err={err!r}")


def run_govc(env, args, check=True):
    e = os.environ.copy()
    e.update(env)
    govc_bin = e.get('GOVC_BIN') or shutil.which('govc') or '/usr/local/bin/govc'
    return subprocess.run([govc_bin] + args, check=check, capture_output=True, text=True, env=e)


def validate_vm_name(name):
    if not VM_RE.match(name or ''):
        raise ValueError('invalid vm name')


def validate_hostname(hostname):
    if not HOST_RE.match(hostname or ''):
        raise ValueError('invalid hostname')


def validate_network(cfg, net):
    allowed = cfg.get('allowed_networks', [])
    if net not in allowed:
        raise ValueError(f'network not allowed: {net}')


def validate_template(cfg, template):
    t = cfg.get('templates', {}).get(template)
    if not t:
        raise ValueError(f'template not found: {template}')
    for k in ('path', 'vmx', 'disk', 'datastore'):
        if not t.get(k):
            raise ValueError(f'template.{k} missing')
    return t


def validate_datastore(cfg, datastore):
    ds = cfg.get('datastores', {}).get(datastore)
    if not ds:
        raise ValueError(f'unknown datastore: {datastore}')
    if not ds.get('path'):
        raise ValueError(f'datastores.{datastore}.path missing')
    return ds


def resolve_target_datastore(cfg, requested=None):
    target = requested or cfg.get('esxi', {}).get('default_datastore')
    if not target:
        raise ValueError('default datastore is not configured')
    validate_datastore(cfg, target)
    return target


def validate_template_placement(template, target_datastore):
    allowed = template.get('allowed_datastores')
    if allowed is None:
        allowed = [template['datastore']]
    if target_datastore not in allowed:
        raise ValueError(f"template placement denied: {target_datastore} not in allowed_datastores")


def validate_limits(cfg, cpu, ram_mb, disk_gb):
    lim = cfg.get('limits', {})
    if cpu > lim.get('max_cpu', 8):
        raise ValueError('cpu above limit')
    if ram_mb > lim.get('max_ram_mb', 32768):
        raise ValueError('ram above limit')
    if disk_gb > lim.get('max_disk_gb', 300):
        raise ValueError('disk above limit')


def _validate_safe_leaf_name(name, label='name'):
    if not name or name.strip() != name:
        raise ValueError(f'unsafe {label}')
    if '/' in name or '\\' in name or '*' in name or '?' in name or '[' in name or ']' in name or '$' in name or '~' in name:
        raise ValueError(f'unsafe {label}')
    if '..' in name:
        raise ValueError(f'unsafe {label}')


def validate_safe_vm_path(cfg, datastore, path, vm_name):
    _validate_safe_leaf_name(vm_name, 'vm name')
    ds = validate_datastore(cfg, datastore)
    exp = os.path.normpath(f"{ds['path']}/{vm_name}")
    p = os.path.normpath(path)
    if p in ('', '/', '/vmfs', '/vmfs/volumes', os.path.normpath(ds['path'])):
        raise ValueError('unsafe vm path')
    if p != exp:
        raise ValueError('unsafe vm path')


def validate_safe_deleted_path(cfg, datastore, path, deleted_name=None):
    ds = validate_datastore(cfg, datastore)
    deleted_dir = ds.get('deleted_dir', '_deleted')
    root = os.path.normpath(f"{ds['path']}/{deleted_dir}")
    p = os.path.normpath(path)
    if p == root:
        raise ValueError('unsafe deleted path')
    if not p.startswith(root + os.sep):
        raise ValueError('unsafe deleted path')
    tail = p[len(root)+1:]
    if '/' in tail or '\\' in tail:
        raise ValueError('unsafe deleted leaf')
    _validate_safe_leaf_name(tail, 'deleted leaf')
    if deleted_name is not None and tail != deleted_name:
        raise ValueError('unsafe deleted leaf')


def json_write_atomic(path, obj):
    path = pathlib.Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=path.name, text=True)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(obj, f, indent=2, ensure_ascii=False)
            f.write('\n')
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def json_read(path, default=None):
    p = pathlib.Path(path)
    if not p.exists():
        return {} if default is None else default
    with open(p, 'r', encoding='utf-8') as f:
        return json.load(f)


@contextmanager
def acquire_flock(path):
    pathlib.Path(path).parent.mkdir(parents=True, exist_ok=True)
    with open(path, 'a+', encoding='utf-8') as f:
        fcntl.flock(f.fileno(), fcntl.LOCK_EX)
        f.seek(0)
        f.truncate(0)
        f.write(str(os.getpid()))
        f.flush()
        try:
            yield
        finally:
            fcntl.flock(f.fileno(), fcntl.LOCK_UN)


def render_metadata(instance_id, hostname):
    md = {
        'instance-id': instance_id,
        'local-hostname': hostname,
        'wait-on-network': {'ipv4': True},
        'redact': ['userdata', 'vendordata'],
    }
    return yaml.safe_dump(md, sort_keys=False)


def render_userdata(username, ssh_key):
    ud = {
        'users': [{
            'name': username, 'groups': 'wheel', 'shell': '/bin/bash',
            'sudo': ['ALL=(ALL) NOPASSWD:ALL'], 'ssh_authorized_keys': [ssh_key]
        }],
        'ssh_pwauth': False,
        'disable_root': True,
        'growpart': {'mode': 'auto', 'devices': ['/'], 'ignore_growroot_disabled': False},
        'resize_rootfs': True,
        'runcmd': [
            'systemctl enable --now vmtoolsd || true',
            'vmware-rpctool "info-set guestinfo.vmctl.cloudinit_status ready" || true',
            'vmware-rpctool "info-set guestinfo.vmctl.cloudinit_done_at $(date -Iseconds)" || true'
        ]
    }
    return '#cloud-config\n' + yaml.safe_dump(ud, sort_keys=False)


def sanitize_or_render_vmx(template_vmx_text, vm_name, cpu, ram_mb, network, state_uuid, instance_id, created_at):
    forced = {
        'displayName': vm_name, 'numvcpus': str(cpu), 'memSize': str(ram_mb),
        'scsi0:0.fileName': f'{vm_name}.vmdk', 'nvram': f'{vm_name}.nvram', 'extendedConfigFile': f'{vm_name}.vmxf',
        'ethernet0.present': 'TRUE', 'ethernet0.virtualDev': 'vmxnet3', 'ethernet0.networkName': network,
        'ethernet0.addressType': 'generated', 'ethernet0.startConnected': 'TRUE',
        'guestinfo.vmctl.managed': 'true', 'guestinfo.vmctl.owner': 'hermes', 'guestinfo.vmctl.name': vm_name,
        'guestinfo.vmctl.state_uuid': state_uuid, 'guestinfo.vmctl.instance_id': instance_id,
        'guestinfo.vmctl.created_at': created_at,
    }
    forced_keys = {k.lower() for k in forced.keys()}
    banned_prefixes = [
        'uuid.bios', 'uuid.location', 'vc.uuid', 'sched.swap.derivedname',
        'ethernet0.generatedaddress', 'ethernet0.generatedaddressoffset', 'ethernet0.address',
        'ethernet0.addresstype', 'generatedaddress', 'migrate.hostlog', 'checkpoint.vmstate',
        'toolsinstallmanager.updatecounter', 'guestos.detailed.data', 'guestinfo.detailed.data', 'scsi0:0.redo',
        'snapshot.action', 'snapshot.current'
    ]
    out = []
    for line in template_vmx_text.splitlines():
        s = line.strip()
        if not s or s.startswith('#') or '=' not in s:
            continue
        key, value = s.split('=', 1)
        key = key.strip()
        value = value.strip()
        kl = key.lower()
        if kl in forced_keys:
            continue
        if any(kl == p or kl.startswith(p) for p in banned_prefixes):
            continue
        out.append(f'{key} = {value}')
    for k, v in forced.items():
        out.append(f'{k} = "{v}"')
    return '\n'.join(out) + '\n'




